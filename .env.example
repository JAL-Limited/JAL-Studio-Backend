NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/eko_store
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
DELIVERY_FEE_KOBO=1500000
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_paystack_test_secret
PAYSTACK_CALLBACK_URL=https://standard.paystack.co/close
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:8765
# Optional password reset email delivery (all four required to enable it).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
# SMTP_FROM=JAL Studio <support@example.com>